# Copy to .env.local and fill in. Every integration is optional: the site,
# the engine and the whole funnel run without any of them, using a local
# file store and a simulated payment.

NEXT_PUBLIC_SITE_URL=https://astrorishi.org

# --- Database (Supabase). Without these, a JSON file under .data/ is used. ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Razorpay). Without these, checkout uses a dev test payment. ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Report prose (Google Gemini). Without this, reports render from computed
#     facts only — every number is still present and correct. ---
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.6-flash

# --- Delivery ---
# RESEND_API_KEY=

# --- Admin (/admin). At least 8 characters. ---
# ADMIN_PASSWORD=

# --- Meta ads ---
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_TOKEN=
